{
    "version": 4,
    "configurations": [
        {
            "name": "Arduino Tab5",
            "compilerPath": "${env:HOME}/Library/Arduino15/packages/esp32/tools/esp-rv32/2601/bin/riscv32-esp-elf-g++",
            "compilerArgs": ["-MMD", "-Werror=return-type"],
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${workspaceFolder}/M5Tab5_Audio_Probe",
                "${workspaceFolder}/M5Tab5_Digifant_Analyzer",
                "${workspaceFolder}/M5Tab5_Digifant_Analyzer/src",
                "${workspaceFolder}/M5Tab5_Digifant_Proto",
                "${workspaceFolder}/M5Tab5_Touch_Probe",
                "${env:HOME}/Documents/Arduino/libraries/M5Unified/src",
                "${env:HOME}/Documents/Arduino/libraries/M5GFX/src",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/*/cores/esp32",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/*/variants/m5stack_tab5",
                "${env:HOME}/Library/Arduino15/packages/esp32/tools/esp32p4_es-libs/*/include/**",
                "${env:HOME}/Library/Arduino15/packages/esp32/tools/esp-rv32/*/riscv32-esp-elf/include/**"
            ],
            "defines": [
                "F_CPU=360000000L",
                "ARDUINO=10607",
                "ARDUINO_M5STACK_TAB5",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_BOARD=\"M5STACK_TAB5\"",
                "ARDUINO_VARIANT=\"m5stack_tab5\"",
                "BOARD_HAS_PSRAM",
                "ARDUINO_USB_MODE=1",
                "ARDUINO_USB_CDC_ON_BOOT=1"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17"
        }
    ]
}
